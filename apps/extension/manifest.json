{
  "manifest_version": 3,
  "name": "ShadowShield",
  "version": "0.1.0",
  "description": "Enterprise AI Data Protection",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "dist/content/chatgpt-content.js"
      ]
    }
  ]
}
